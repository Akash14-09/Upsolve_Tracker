{
  "manifest_version": 3,
  "name": "Upsolve Tracker Extension",
  "version": "1.2.0",
  "description": "1-Click minimalist '+' upsolve button for Codeforces, LeetCode, and CodeChef.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
